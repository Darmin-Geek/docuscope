rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's profile document id is their Firebase auth uid (see
    // docs/dataModel.md). Anyone signed in may read profiles, but a user may
    // only create or edit their OWN profile, and the only field they can write
    // is their name. Note Firestore rules are permissive (access is granted if
    // ANY match allows it), so the placeholder rule below is deliberately
    // scoped to /projects rather than a top-level /{document=**} wildcard —
    // otherwise it would also grant write access to /users and defeat this.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string;
    }

    // A project — and everything inside it — is private to its contributors.
    // Contributors are stored as a list of emails on the project document (see
    // docs/dataModel.md), so access is decided by matching the signed-in user's
    // email against that list.
    match /projects/{projectId} {
      // True when the signed-in user's email is one of an EXISTING project's
      // contributors. Uses `resource.data`, so it's only valid where the
      // document already exists (read/update/delete), not on create.
      function isContributor() {
        return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email in resource.data.contributors;
      }

      // Reading, editing, or deleting a project requires being a contributor.
      allow read, update, delete: if isContributor();

      // A newly created project must list its creator (the signed-in user) as a
      // contributor, so nobody can create a project they're then locked out of.
      allow create: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in request.resource.data.contributors;

      // Every subcollection under a project (files, folders, labels and their
      // own nested subcollections like information and comments) is reachable
      // only by the parent project's contributors. The parent project is looked
      // up by id to read its current contributor list.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email in
            get(/databases/$(database)/documents/projects/$(projectId)).data.contributors;
      }
    }
  }
}
