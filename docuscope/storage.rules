rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // A project's files in Storage are private to that project's contributors.
    // The contributor list lives on the project's Firestore document (a list of
    // emails, see docs/dataModel.md), so look it up and match the signed-in
    // user's email against it.
    match /projects/{projectId}/files/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in
          firestore.get(/databases/(default)/documents/projects/$(projectId)).data.contributors;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}