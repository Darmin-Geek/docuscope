# Copy to `.env` (auto-loaded by docker-compose) to override the debug `app`
# service. Every value has a safe default in docker-compose.yml, so `.env` is
# optional. Do NOT put long-lived AWS secret keys here — see the note below.

# --- Test bypass -------------------------------------------------------------
# Enables the verifyAuth test token and a plain-password DB connection.
# TEST_AUTH_SECRET=local-debug-secret

# --- AWS service identifiers (not secret) ------------------------------------
# AWS_REGION=us-east-2
# S3_BUCKET_NAME=
# S3_ENDPOINT=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# NEXT_PUBLIC_AWS_REGION=us-east-2
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AWS credentials ---------------------------------------------------------
# Credentials are NOT supplied here. The container mounts your host ~/.aws
# directory read-only and the AWS SDK reads from it at runtime, so secrets never
# enter the image or compose config. Point at a named profile (and, if your
# config lives elsewhere, set the host directory):
# AWS_PROFILE=default
# HOST_AWS_DIR=/absolute/path/to/.aws
